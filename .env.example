# Pulse — environment contract.
# Copy to `.env` (never committed). Never place service-role or secret keys in a
# client build. Clients receive ONLY the publishable anon key below.

# --- Supabase (required for any real data) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=publishable-or-anon-key-only

# Android reads these from android/local.properties (git-ignored):
#   supabase.url=...
#   supabase.anonKey=...
# iOS reads these from ios/Config/Secrets.xcconfig (git-ignored):
#   SUPABASE_URL=...
#   SUPABASE_ANON_KEY=...

# --- Server-side only. Never referenced by Android or iOS code. ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:***@db.your-project-ref.supabase.co:5432/postgres

# --- Integrations (all optional; each one has a real "not configured" state) ---
MAPS_PROVIDER=
MAPS_API_KEY=
PAYMENTS_PROVIDER=
PAYMENTS_SECRET_KEY=
WHATSAPP_PROVIDER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
FCM_SERVER_KEY=
