# Pulse local service — configuration template.
#
# Copy to .env in this directory (pulse/services/.env) and fill in what you have.
# Every section is optional except Supabase: with nothing set the service still
# runs, the portal still loads, and it tells you exactly what is missing instead
# of showing invented data.
#
# Nothing here is read by the Android app or the web client. This file stays on
# the machine running the service.

# ── Supabase (required for any order data) ────────────────────────────────────
# Project URL and the anon key — the same two values the Android app ships with.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=paste-anon-key

# Never required, and this service will not use it for a portal request even if
# present: the caller's own bearer token is forwarded so Postgres RLS decides.
# It is read only by admin tasks you run yourself.
# SUPABASE_SERVICE_ROLE_KEY=

# ── Maps (address → coordinates, distance, ETA) ───────────────────────────────
# One of: nominatim | mapbox | google | osrm
MAPS_PROVIDER=nominatim

# nominatim is free and keyless, but its usage policy demands an identifying
# User-Agent and at most one request per second.
NOMINATIM_USER_AGENT=pulse-local-service/0.1 (your-email@example.com)
# Optional: bias address matching, e.g. NG,GH
# GEO_COUNTRY_CODES=NG

# MAPS_PROVIDER=mapbox
# MAPBOX_ACCESS_TOKEN=
# MAPS_PROVIDER=google
# GOOGLE_MAPS_API_KEY=
# MAPS_PROVIDER=osrm        # routes only; it cannot geocode
# OSRM_BASE_URL=https://router.project-osrm.org
# A single key usable by whichever provider MAPS_PROVIDER selects:
# MAPS_API_KEY=

# ── Payments (verification only — a human still records payment) ─────────────
# PAYSTACK_SECRET_KEY=
# PAYSTACK_WEBHOOK_SECRET=
# FLUTTERWAVE_SECRET_KEY=

# ── WhatsApp (order text is parsed with no key at all) ───────────────────────
# Outbound messages and the inbound webhook need a Cloud API setup.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Without this secret the webhook refuses inbound deliveries instead of
# trusting an unsigned payload.
# WHATSAPP_APP_SECRET=

# ── Push to the Android app (needs google-auth installed — see README) ───────
# FCM_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_FILE=./service-account.json

# ── SMTP for invitation codes (codes are created in the DB either way) ───────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=Pulse <no-reply@example.com>
# Where the worker should paste the code:
# MAIL_INVITE_URL=http://localhost:3000/join

# ── Realtime board (until migration 0016 is applied the portal polls) ────────
# REALTIME_ENABLED=true

# ── The service itself ──────────────────────────────────────────────────────
PULSE_HOST=127.0.0.1
PULSE_PORT=8000

# In a container, PULSE_HOST must be 0.0.0.0 — the default binds loopback inside the
# container and answers connection-refused to everything outside it. Fly, Render,
# Railway and Cloud Run set PORT for you; PULSE_PORT is the local spelling and wins
# when both are present.

# Absolute path to a built partner-web `dist/` directory. Set, it is served at / with
# deep links falling back to index.html; unset, the dispatcher portal in
# pulse_service/portal/ is served exactly as it always was. The Dockerfile sets this
# to /srv/web. See docs/deployment.md.
# PULSE_WEB_ROOT=/srv/web
